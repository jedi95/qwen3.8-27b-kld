# Qwen3.8-27B KLD campaign — machine-local configuration.
# Copy to .env and adjust. `cp .env.example .env`
# .env is gitignored; setup_env.sh writes the paths it creates back into it.

# Python interpreter of the venv (created by scripts/setup_env.sh)
KLD_PY=/absolute/path/to/.venv/bin/python

# Workspace where setup_env.sh clones vllm / b12x / builds the venv
KLD_WORKDIR=$HOME/kld-env

# GPU selection. The published results were captured on ONE 96GB Blackwell
# GPU, TP=1, with no other workload on it. Set this to a free GPU id on your
# machine; TP>1 is NOT the captured configuration (results are TP=1 numbers).
KLD_GPU_IDS=0
KLD_TP=1

# Directory containing exllamav3_ext*.so (JIT-built by setup_env.sh).
# Only needed for EXL3 candidates; leave unset to let the engine JIT-build it.
#VLLM_EXL3_EXT_PATH=/absolute/path/to/ext-dir

# GPU memory fraction for engine init (0.90 in the captured configuration;
# lower it if the GPU is shared, but that changes the run).
KLD_GPU_MEM_UTIL=0.90

# HuggingFace hub cache (models are auto-downloaded at the pinned revisions in
# configs/models.yaml; ~500 GB total across all candidates + BF16 reference).
#HF_HOME=$HOME/.cache/huggingface
